{
  "manifest_version": 3,
  "name": "LC0 Bot for Lichess",
  "version": "0.3.0",
  "key": "",
  "description": "Lichess extension using a local LC0 Native Messaging host",
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "core/logger.js",
        "core/state.js",
        "core/bridge-api.js",
        "engine/stockfish-eval.js",
        "ui/eval-bar.js",
        "ui/control-panel.js",
        "ui/keyboard-shortcuts.js",
        "automation/scheduler.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "adapters/lichess-dom.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "LC0 Bot for Lichess",
    "default_popup": "popup.html"
  }
}
